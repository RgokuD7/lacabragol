# Sofascore RapidAPI (para proxy local server.ts)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="sportapi7.p.rapidapi.com"

# Google Gemini API Key (Opcional)
GEMINI_API_KEY=""

# Configuración Firebase Web Client
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="lacabragol.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="lacabragol"
VITE_FIREBASE_STORAGE_BUCKET="lacabragol.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="908751231296"
VITE_FIREBASE_APP_ID="1:908751231296:web:YOUR_APP_ID"
